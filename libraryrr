----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function ProtectGui(gui)
	if syn and syn.protect_gui then
		syn.protect_gui(gui)
		gui.Parent = CoreGui -- в оригинале в этой ветке Parent не выставлялся
	elseif gethui then
		gui.Parent = gethui()
	else
		gui.Parent = CoreGui
	end
end

local function Create(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent -- Parent ставим последним (быстрее и без лишних пересчётов)
	end
	return inst
end

local function Corner(inst, radius)
	return Create("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function Stroke(inst, color, thickness)
	return Create("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function Tween(inst, time, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Loop(inst, time, props)
	local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), props)
	tw:Play()
	return tw
end

local function Fire(cb, ...)
	if not cb then
		return
	end
	local ok, err = pcall(cb, ...)
	if not ok then
		warn("[CelestialLib] callback error: " .. tostring(err))
	end
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function Label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Library.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return Create("TextLabel", base, parent)
end

-- Иконка-кнопка: ImageButton если есть id, иначе текстовый символ
local function IconButton(parent, iconId, glyph, size)
	local T = Library.Theme
	local btn
	if iconId and iconId ~= "" then
		btn = Create("ImageButton", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
			Image = iconId, ImageColor3 = T.SubText, ScaleType = Enum.ScaleType.Fit,
		}, parent)
	else
		btn = Create("TextButton", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
			Text = glyph, TextColor3 = T.SubText, Font = Enum.Font.GothamBold, TextSize = size - 4,
		}, parent)
	end
	local prop = btn:IsA("ImageButton") and "ImageColor3" or "TextColor3"
	btn.MouseEnter:Connect(function() Tween(btn, 0.1, { [prop] = T.Text }) end)
	btn.MouseLeave:Connect(function() Tween(btn, 0.1, { [prop] = T.SubText }) end)
	return btn, prop
end

-- (де)сериализация значений для конфигов
local function Encode(v)
	if typeof(v) == "Color3" then
		return { t = "c3", r = v.R, g = v.G, b = v.B }
	elseif typeof(v) == "EnumItem" then
		return { t = "key", n = v.Name }
	end
	return v
end

local function Decode(v)
	if type(v) == "table" then
		if v.t == "c3" then
			return Color3.new(v.r, v.g, v.b)
		elseif v.t == "key" then
			local ok, key = pcall(function() return Enum.KeyCode[v.n] end)
			return ok and key or nil
		end
	end
	return v
end

-- Ждёт следующую клавишу; Esc/Backspace = сбросить (cb(nil))
function Library:_listenKey(cb)
	self._listening = true
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		conn:Disconnect()
		task.defer(function() self._listening = false end) -- чтобы глобальный обработчик не поймал ту же клавишу
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
			cb(nil)
		else
			cb(input.KeyCode)
		end
	end)
end

