	for k, v in pairs(props) do
		base[k] = v
	end
	return Create("TextLabel", base, parent)
end

-- Иконка-кнопка: ImageButton если есть id, иначе текстовый символ
local function IconButton(parent, iconId, glyph, size)
	local T = Library.Theme
	local btn
	if iconId and iconId ~= "" then
		btn = Create("ImageButton", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
			Image = iconId, ImageColor3 = T.SubText, ScaleType = Enum.ScaleType.Fit,
		}, parent)
	else
		btn = Create("TextButton", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
			Text = glyph, TextColor3 = T.SubText, Font = Enum.Font.GothamBold, TextSize = size - 4,
		}, parent)
	end
	local prop = btn:IsA("ImageButton") and "ImageColor3" or "TextColor3"
	btn.MouseEnter:Connect(function() Tween(btn, 0.1, { [prop] = Library.Theme.Text }) end)
	btn.MouseLeave:Connect(function() Tween(btn, 0.1, { [prop] = Library.Theme.SubText }) end)
	return btn, prop
end

-- (де)сериализация значений для конфигов
local function Encode(v)
	if typeof(v) == "Color3" then
		return { t = "c3", r = v.R, g = v.G, b = v.B }
	elseif typeof(v) == "EnumItem" then
		return { t = "key", n = v.Name }
	end
	return v
end

local function Decode(v)
	if type(v) == "table" then
		if v.t == "c3" then
			return Color3.new(v.r, v.g, v.b)
		elseif v.t == "key" then
			local ok, key = pcall(function() return Enum.KeyCode[v.n] end)
			return ok and key or nil
		end
	end
	return v
end

-- Ждёт следующую клавишу; Esc/Backspace = сбросить (cb(nil))
function Library:_listenKey(cb)
	self._listening = true
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		conn:Disconnect()
		task.defer(function() self._listening = false end) -- чтобы глобальный обработчик не поймал ту же клавишу
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
			cb(nil)
		else
			cb(input.KeyCode)
		end
	end)
end

