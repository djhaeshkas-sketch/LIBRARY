		Size = UDim2.fromOffset(120, 24), Position = UDim2.new(1, -132, 0.5, -12),
		BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = T.Text,
		PlaceholderText = o.Placeholder or "", PlaceholderColor3 = T.SubText,
		Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
		Text = tostring(el.Value or ""), TextXAlignment = Enum.TextXAlignment.Left,
		ClipsDescendants = true,
	}, row)
	Corner(box, 4)
	Create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, box)

	local function refresh()
		if not box:IsFocused() then
			box.Text = tostring(el.Value or "")
		end
	end

	box.FocusLost:Connect(function(enterPressed)
		local text = box.Text
		if o.Numeric then
			local n = tonumber(text)
			if not n then
				box.Text = tostring(el.Value or "")
				return
			end
			if o.Min then n = math.max(n, o.Min) end
			if o.Max then n = math.min(n, o.Max) end
			el:Set(n)
		else
			el:Set(text)
		end
	end)

	el._refresh = refresh
	refresh()
end

-- Сворачиваемая группа: рисует заголовок со стрелкой + вложенный контейнер с дочерними элементами.
-- Рекурсивно поддерживает вложенные группы.
local function RenderElement(el, container, conns, hostFrame)
	if el.Type == "Group" then
		local header = Row(container, ROW_HEIGHT.Group)
		local arrow = Label(header, {
			Size = UDim2.fromOffset(20, ROW_HEIGHT.Group), Position = UDim2.fromOffset(4, 0),
			Text = el.Collapsed and "▸" or "▾", Font = Enum.Font.GothamBold, TextSize = 12,
		})
		RowLabel(header, el.Name, { Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(26, 0), Font = Enum.Font.GothamBold })

		local body = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y, Visible = not el.Collapsed, ClipsDescendants = true,
		}, container)
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
		Create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingTop = UDim.new(0, 4) }, body)

		for _, child in ipairs(el.Elements) do
			RenderElement(child, body, conns, hostFrame)
		end

		local click = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, header)
		click.MouseButton1Click:Connect(function()
			el.Collapsed = not el.Collapsed
			body.Visible = not el.Collapsed
			arrow.Text = el.Collapsed and "▸" or "▾"
		end)
	else
		local render = Renderers[el.Type]
		if render then
			render(el, container, conns, hostFrame)
		end
	end
end

local function MeasureElements(elements)
	local h = 0
	for _, el in ipairs(elements) do
		if el.Type == "Group" then
			h += ROW_HEIGHT.Group + 8
			if not el.Collapsed then
				h += MeasureElements(el.Elements) -- грубая оценка (не критично — есть скролл)
			end
		else
			h += (ROW_HEIGHT[el.Type] or 30) + 8
		end
	end
	return h
end

local function ClearRefreshRecursive(elements)
	for _, el in ipairs(elements) do
		if el._closeDropdown then pcall(el._closeDropdown) end
		el._refresh = nil
		if el.Type == "Group" then
			ClearRefreshRecursive(el.Elements)
		end
	end
end

