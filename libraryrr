-- Library:Notify({ Title = "Speed включён", Text = "Функция активирована", Type = "success", Duration = 3 })
function Library:Notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	local T = self.Theme
	local kind = NOTIFY[opts.Type or "info"] or NOTIFY.info
	local duration = opts.Duration or 3

	notifyCounter += 1
	local holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, LayoutOrder = -notifyCounter, -- новые сверху
	}, GetNotifyList())

	local n = Create("Frame", {
		Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 40, 0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, holder)
	Corner(n, 8)
	local grad = Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHex("#1a0a2e")),
			ColorSequenceKeypoint.new(0.5, Color3.fromHex("#2d1b4e")),
			ColorSequenceKeypoint.new(1, Color3.fromHex("#1a0a2e")),
		}),
	}, n)
	Loop(grad, 4, { Rotation = 360 })
	Stroke(n, kind.border, 1.5)

	local iconBg = Create("Frame", {
		Size = UDim2.fromOffset(36, 36), Position = UDim2.new(0, 12, 0.5, -18),
		BackgroundColor3 = kind.bg, BorderSizePixel = 0,
	}, n)
	Corner(iconBg, 18)
	local iconId = self.Icons[kind.icon]
	if iconId and iconId ~= "" then
		Create("ImageLabel", {
			Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4),
			BackgroundTransparency = 1, Image = iconId, ScaleType = Enum.ScaleType.Fit,
		}, iconBg)
	else
		Label(iconBg, {
			Size = UDim2.fromScale(1, 1), Text = kind.glyph, Font = Enum.Font.GothamBold,
			TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center,
		})
	end

	Label(n, {
		Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(58, 8), Text = opts.Title or "",
		Font = Enum.Font.GothamBold, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Label(n, {
		Size = UDim2.new(1, -70, 0, 16), Position = UDim2.fromOffset(58, 30), Text = opts.Text or kind.sub,
		TextSize = 11, TextColor3 = T.SubText,
	})

	local bar = Create("Frame", {
		Size = UDim2.new(1, -4, 0, 2), Position = UDim2.new(0, 2, 1, -4),
		BackgroundColor3 = kind.border, BorderSizePixel = 0,
	}, n)
	Corner(bar, 1)

	Tween(n, 0.4, { Position = UDim2.new() }, Enum.EasingStyle.Back)
	Tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	if opts.Type == "error" then
		task.delay(0.4, function()
			for _ = 1, 3 do
				if not n.Parent then return end
				Tween(n, 0.05, { Position = UDim2.fromOffset(5, 0) })
				task.wait(0.05)
				Tween(n, 0.05, { Position = UDim2.fromOffset(-5, 0) })
				task.wait(0.05)
			end
			Tween(n, 0.1, { Position = UDim2.new() })
		end)
	end

	task.delay(duration, function()
		if not n.Parent then return end
		Tween(n, 0.3, { Position = UDim2.new(0, 350, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.3)
		Tween(holder, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		task.wait(0.2)
		holder:Destroy()
	end)
end

