-- Переключает тему целиком. Мутирует Library.Theme "на месте", поэтому весь код,
-- который каждый раз заново читает Library.Theme.* (hover-эффекты, refresh() элементов,
-- рендеры попапов), сразу подхватывает новые цвета. Остальное (уже нарисованные
-- фоны сайдбара/топбара/карточек, обводка окна) перекрашивается явно ниже.
function Library:SetTheme(name)
	local preset = self.Themes[name]
	if not preset then
		warn("[CelestialLib] неизвестная тема: " .. tostring(name) .. " (доступны: Celestial, PurpleNight, Cosmos)")
		return false
	end
	self.ThemeName = name
	for k, v in pairs(preset) do
		self.Theme[k] = v
	end
	self:_repaintTheme()
	return true
end

function Library:_repaintTheme()
	local T = self.Theme

	for _, w in ipairs(self.Windows) do
		if w.Main and w.Main.Parent then
			if w.MainStroke then
				Tween(w.MainStroke, 0.25, { Color = T.Border })
			end
			if w.BgGrad then
				w.BgGrad.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, T.Background),
					ColorSequenceKeypoint.new(0.5, T.BackgroundAlt),
					ColorSequenceKeypoint.new(1, T.Background),
				})
			end
			if w.Sidebar then Tween(w.Sidebar, 0.25, { BackgroundColor3 = T.Sidebar }) end
			if w.Topbar then Tween(w.Topbar, 0.25, { BackgroundColor3 = T.Topbar }) end
			for _, tab in ipairs(w.TabList) do
				if tab._setSelected then tab._setSelected(w.Current == tab) end
			end
			if w._separators then
				for _, lbl in ipairs(w._separators) do
					if lbl.Parent then lbl.TextColor3 = T.SubText end
				end
			end
		end

		-- перекрасить открытые попапы (если они сейчас на экране)
		for _, key in ipairs({ "_popupFrame", "_configFrame", "_friendFrame", "_themeFrame" }) do
			local frame = w[key]
			if frame and frame.Parent then
				Tween(frame, 0.25, { BackgroundColor3 = T.Popup })
				local stroke = frame:FindFirstChildOfClass("UIStroke")
				if stroke then Tween(stroke, 0.25, { Color = T.ActiveBorder }) end
			end
		end
	end

	for _, f in ipairs(self.Features) do
		if f._repaint then
			pcall(f._repaint)
		end
	end

	for _, el in pairs(self.Elements) do
		if el._refresh then
			pcall(el._refresh)
		end
	end
end

