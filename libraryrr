function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local T = self.Theme
	self:_init()

	local Window = {
		Tabs = {}, TabList = {}, Current = nil, Minimized = false, Visible = true,
		ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightControl,
		NotifyOnToggle = cfg.NotifyOnToggle ~= false,
	}
	local order = 0
	local function nextOrder() order += 1 return order end
	local size = cfg.Size or Vector2.new(800, 520)

	local gui = Create("ScreenGui", {
		Name = cfg.Name or "CelestialUI", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999,
	})
	ProtectGui(gui)
	Window.Gui = gui

	-- Главное окно: AnchorPoint по центру, поэтому анимация открытия = просто твин размера
	local main = Create("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	Corner(main, 10)
	local mainStroke = Stroke(main, T.Border, 1)
	local bgGrad = Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, T.Background),
			ColorSequenceKeypoint.new(0.5, T.BackgroundAlt),
			ColorSequenceKeypoint.new(1, T.Background),
		}),
	}, main)
	Loop(bgGrad, 8, { Rotation = 360 })
	Tween(main, 0.5, { Size = UDim2.fromOffset(size.X, size.Y), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
	Window.Main = main
	Window.MainStroke = mainStroke
	Window.BgGrad = bgGrad

	-- Overlay: отдельный слой поверх main (создан позже main => рендерится сверху, как сиблинг в gui).
	-- Здесь живут блокер кликов, попапы настроек/конфигов/друзей и списки дропдаунов —
	-- у main стоит ClipsDescendants = true, из-за чего всё вышеперечисленное резалось/пропадало
	-- на краю окна. На overlay такого ограничения нет, поэтому попапы можно таскать
	-- в любое место экрана, и они никогда не "срезаются".
	local overlay = Create("Frame", {
		Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
	}, gui)
	Window.Overlay = overlay

	-- Sidebar
	local sidebar = Create("Frame", { Name = "Sidebar", Size = UDim2.new(0, 160, 1, 0), BackgroundColor3 = T.Sidebar, BorderSizePixel = 0 }, main)
	Corner(sidebar, 10)
	Window.Sidebar = sidebar

	local logoFrame = Create("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1 }, sidebar)
	local logoBg = Create("Frame", {
		Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(14, 9),
