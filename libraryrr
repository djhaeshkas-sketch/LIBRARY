	local function makeSidebarButton(name, icon, glyph, iconSize)
		iconSize = iconSize or 18
		local btn = Create("TextButton", {
			Name = name, Size = UDim2.new(1, -16, 0, 34), BackgroundColor3 = T.Card, BackgroundTransparency = 1,
			Text = "", AutoButtonColor = false, LayoutOrder = nextOrder(),
		}, sidebarContent)
		Corner(btn, 8)
		local indicator = Create("Frame", {
			Size = UDim2.fromOffset(3, 16), Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = Library.Theme.ActiveBorder, BackgroundTransparency = 1, BorderSizePixel = 0,
		}, btn)
		Corner(indicator, 2)

		local x = 12
		local iconObj
		if icon and icon ~= "" then
			iconObj = Create("ImageLabel", {
				Size = UDim2.fromOffset(iconSize, iconSize), Position = UDim2.new(0, 12, 0.5, -iconSize / 2), BackgroundTransparency = 1,
				Image = icon, ImageColor3 = Library.Theme.Inactive, ScaleType = Enum.ScaleType.Fit,
			}, btn)
			x = 12 + iconSize + 8
		end
		local text = Label(btn, {
			Size = UDim2.new(1, -(x + 6), 1, 0), Position = UDim2.fromOffset(x, 0), Text = name,
			Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Library.Theme.Inactive,
		})

		local selected = false
		local function setSelected(sel)
			selected = sel
			local TT = Library.Theme
			Tween(btn, 0.2, { BackgroundTransparency = sel and 0 or 1, BackgroundColor3 = TT.Card })
			Tween(indicator, 0.2, { BackgroundTransparency = sel and 0 or 1, BackgroundColor3 = TT.ActiveBorder })
			Tween(text, 0.2, { TextColor3 = sel and TT.Text or TT.Inactive })
			if iconObj then
				Tween(iconObj, 0.2, { ImageColor3 = sel and TT.ActiveBorder or TT.Inactive })
			end
		end
		btn.MouseEnter:Connect(function()
			if not selected then Tween(text, 0.15, { TextColor3 = Library.Theme.Text }) end
		end)
		btn.MouseLeave:Connect(function()
