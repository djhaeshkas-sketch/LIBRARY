	local popup, popupFeature, popupConns = nil, nil, {}

	function Window:ClosePopup()
		if not popup then
			return
		end
		local p = popup
		popup = nil
		for _, c in ipairs(popupConns) do
			c:Disconnect()
		end
		popupConns = {}
		if popupFeature then
			for _, el in ipairs(popupFeature.Elements) do
				el._refresh = nil
			end
		end
		popupFeature = nil
		Tween(p, 0.15, { Size = UDim2.fromOffset(280, 0), BackgroundTransparency = 1 })
		task.delay(0.15, function() p:Destroy() end)
	end

