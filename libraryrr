			Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -32, 0, 8), BackgroundColor3 = Color3.fromRGB(80, 25, 25),
			Text = "X", TextColor3 = T.Text, Font = Enum.Font.GothamBold, TextSize = 12,
		}, p)
		Corner(close, 5)
		close.MouseButton1Click:Connect(function() self:ClosePopup() end)

		local list = Create("ScrollingFrame", {
			Size = UDim2.new(1, -24, 1, -50), Position = UDim2.fromOffset(12, 44), BackgroundTransparency = 1,
