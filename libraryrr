local NOTIFY = {
	info    = { border = Color3.fromRGB(148, 0, 211),  bg = Color3.fromHex("#4a148c"), icon = "NotifyInfo",    glyph = "i", sub = "Информация" },
	success = { border = Color3.fromRGB(50, 255, 100), bg = Color3.fromHex("#1b5e20"), icon = "NotifySuccess", glyph = "✓", sub = "Готово" },
	error   = { border = Color3.fromRGB(255, 60, 60),  bg = Color3.fromHex("#7f0000"), icon = "NotifyError",   glyph = "×", sub = "Ошибка" },
}

local notifyGui, notifyList
local notifyCounter = 0

local function GetNotifyList()
	if notifyGui and notifyGui.Parent then
		return notifyList
	end
	notifyGui = Create("ScreenGui", {
		Name = "CelestialNotifications", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10000,
	})
	ProtectGui(notifyGui)
	notifyList = Create("Frame", {
		Size = UDim2.new(0, 320, 1, -20), Position = UDim2.new(1, -340, 0, 10), BackgroundTransparency = 1,
	}, notifyGui)
	-- UIListLayout сам двигает уведомления при добавлении/удалении (вместо ручного UpdatePositions)
	Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, notifyList)
	return notifyList
end

-- Library:Notify({ Title = "Speed включён", Text = "Функция активирована", Type = "success", Duration = 3 })
function Library:Notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	local T = self.Theme
	local kind = NOTIFY[opts.Type or "info"] or NOTIFY.info
	local duration = opts.Duration or 3

	notifyCounter += 1
	local holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, LayoutOrder = -notifyCounter, -- новые сверху
	}, GetNotifyList())

	local n = Create("Frame", {
		Size = UDim2.fromScale(1, 1), Position = UDim2.new(1, 40, 0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, holder)
	Corner(n, 8)
	local grad = Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHex("#1a0a2e")),
			ColorSequenceKeypoint.new(0.5, Color3.fromHex("#2d1b4e")),
			ColorSequenceKeypoint.new(1, Color3.fromHex("#1a0a2e")),
		}),
	}, n)
	Loop(grad, 4, { Rotation = 360 })
	Stroke(n, kind.border, 1.5)

	local iconBg = Create("Frame", {
		Size = UDim2.fromOffset(36, 36), Position = UDim2.new(0, 12, 0.5, -18),
		BackgroundColor3 = kind.bg, BorderSizePixel = 0,
	}, n)
	Corner(iconBg, 18)
	local iconId = self.Icons[kind.icon]
	if iconId and iconId ~= "" then
		Create("ImageLabel", {
			Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4),
			BackgroundTransparency = 1, Image = iconId, ScaleType = Enum.ScaleType.Fit,
		}, iconBg)
	else
		Label(iconBg, {
			Size = UDim2.fromScale(1, 1), Text = kind.glyph, Font = Enum.Font.GothamBold,
			TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center,
		})
	end

	Label(n, {
		Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(58, 8), Text = opts.Title or "",
		Font = Enum.Font.GothamBold, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Label(n, {
		Size = UDim2.new(1, -70, 0, 16), Position = UDim2.fromOffset(58, 30), Text = opts.Text or kind.sub,
		TextSize = 11, TextColor3 = T.SubText,
	})

	local bar = Create("Frame", {
		Size = UDim2.new(1, -4, 0, 2), Position = UDim2.new(0, 2, 1, -4),
		BackgroundColor3 = kind.border, BorderSizePixel = 0,
	}, n)
	Corner(bar, 1)

	Tween(n, 0.4, { Position = UDim2.new() }, Enum.EasingStyle.Back)
	Tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	if opts.Type == "error" then
		task.delay(0.4, function()
			for _ = 1, 3 do
				if not n.Parent then return end
				Tween(n, 0.05, { Position = UDim2.fromOffset(5, 0) })
				task.wait(0.05)
				Tween(n, 0.05, { Position = UDim2.fromOffset(-5, 0) })
				task.wait(0.05)
			end
			Tween(n, 0.1, { Position = UDim2.new() })
		end)
	end

	task.delay(duration, function()
		if not n.Parent then return end
		Tween(n, 0.3, { Position = UDim2.new(0, 350, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.3)
		Tween(holder, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		task.wait(0.2)
		holder:Destroy()
	end)
end

----------------------------------------------------------------------
-- Settings-popup renderers (один на тип элемента)
-- Каждый рисует строку и вешает el._refresh, чтобы el:Set() обновлял UI.
----------------------------------------------------------------------
local Renderers = {}
local ROW_HEIGHT = { Toggle = 32, Slider = 44, Dropdown = 32, Color = 36, Keybind = 32 }

local function Row(parent, height)
	local r = Create("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = Library.Theme.Row, BorderSizePixel = 0 }, parent)
	Corner(r, 6)
	return r
end

local function RowLabel(row, text, props)
	local p = { Size = UDim2.new(1, -120, 0, 20), Position = UDim2.fromOffset(10, 0), Text = text }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return Label(row, p)
end

local function SmallButton(parent, width)
	local b = Create("TextButton", {
		Size = UDim2.fromOffset(width, 22), Position = UDim2.new(1, -(width + 10), 0.5, -11),
		BackgroundColor3 = Library.Theme.Card, TextColor3 = Library.Theme.Text,
		Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = true,
	}, parent)
	Corner(b, 4)
	return b
end

Renderers.Toggle = function(el, parent)
	local T = Library.Theme
	local row = Row(parent, ROW_HEIGHT.Toggle)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -70, 1, 0) })
	local sw = Create("TextButton", {
		Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -48, 0.5, -10),
		Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(60, 60, 70),
	}, row)
	Corner(sw, 10)
	local knob = Create("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 3, 0.5, -7),
		BackgroundColor3 = T.Text, BorderSizePixel = 0,
	}, sw)
	Corner(knob, 7)

	local function refresh()
		local on = el.Value
		Tween(sw, 0.15, { BackgroundColor3 = on and T.ActiveBorder or Color3.fromRGB(60, 60, 70) })
		Tween(knob, 0.15, { Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) })
	end
	sw.MouseButton1Click:Connect(function() el:Set(not el.Value) end)
	el._refresh = refresh
	refresh()
end

Renderers.Slider = function(el, parent, conns)
	local T = Library.Theme
	local o = el.Opts
	local min, max, step = o.Min or 0, o.Max or 100, o.Increment or 1
	local row = Row(parent, ROW_HEIGHT.Slider)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -80, 0, 22) })
	local valueLbl = Label(row, {
		Size = UDim2.fromOffset(70, 22), Position = UDim2.new(1, -80, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.SubText,
	})
	local track = Create("Frame", {
		Size = UDim2.new(1, -20, 0, 4), Position = UDim2.new(0, 10, 1, -13),
		BackgroundColor3 = Color3.fromRGB(50, 50, 62), BorderSizePixel = 0,
	}, row)
	Corner(track, 2)
	local fill = Create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.ActiveBorder, BorderSizePixel = 0 }, track)
	Corner(fill, 2)
	local hit = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -24), BackgroundTransparency = 1, Text = "",
	}, row)

	local function refresh()
		local a = (max == min) and 0 or (el.Value - min) / (max - min)
		fill.Size = UDim2.fromScale(math.clamp(a, 0, 1), 1)
		valueLbl.Text = tostring(el.Value) .. (o.Suffix or "")
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min)
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		v = tonumber(string.format("%.4f", v))
		if v ~= el.Value then
			el:Set(v)
		end
	end

	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	el._refresh = refresh
	refresh()
end

-- Простой dropdown: клик листает значения по кругу (полноценный список — следующий шаг)
Renderers.Dropdown = function(el, parent)
	local row = Row(parent, ROW_HEIGHT.Dropdown)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -130, 1, 0) })
	local btn = SmallButton(row, 110)
	local values = el.Opts.Values or {}
	local function refresh()
		btn.Text = tostring(el.Value)
	end
	btn.MouseButton1Click:Connect(function()
		local idx = table.find(values, el.Value) or 0
		el:Set(values[idx % #values + 1])
	end)
	el._refresh = refresh
	refresh()
end

Renderers.Color = function(el, parent)
	local T = Library.Theme
	local row = Row(parent, ROW_HEIGHT.Color)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -190, 1, 0) })
	local preview = Create("Frame", {
		Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -176, 0.5, -11),
		BackgroundColor3 = el.Value, BorderSizePixel = 0,
	}, row)
	Corner(preview, 4)

	local boxes = {}
	for i = 1, 3 do
		boxes[i] = Create("TextBox", {
			Size = UDim2.fromOffset(42, 24), Position = UDim2.new(1, -148 + (i - 1) * 48, 0.5, -12),
			BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = T.Text, PlaceholderText = ({ "R", "G", "B" })[i],
			Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, Text = "0",
		}, row)
		Corner(boxes[i], 4)
		boxes[i].FocusLost:Connect(function()
			local r = math.clamp(tonumber(boxes[1].Text) or 0, 0, 255)
			local g = math.clamp(tonumber(boxes[2].Text) or 0, 0, 255)
			local b = math.clamp(tonumber(boxes[3].Text) or 0, 0, 255)
			el:Set(Color3.fromRGB(r, g, b))
		end)
	end

	local function refresh()
		local c = el.Value
		preview.BackgroundColor3 = c
		boxes[1].Text = tostring(math.floor(c.R * 255 + 0.5))
		boxes[2].Text = tostring(math.floor(c.G * 255 + 0.5))
		boxes[3].Text = tostring(math.floor(c.B * 255 + 0.5))
	end
	el._refresh = refresh
	refresh()
end

Renderers.Keybind = function(el, parent)
	local row = Row(parent, ROW_HEIGHT.Keybind)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -110, 1, 0) })
	local btn = SmallButton(row, 90)
	local function refresh()
		btn.Text = el.Value and el.Value.Name or "None"
	end
	btn.MouseButton1Click:Connect(function()
		btn.Text = "..."
		Library:_listenKey(function(key) el:Set(key) end)
	end)
	el._refresh = refresh
	refresh()
end

