local tooltipGui, tooltipLabel

function Library:_initTooltip()
	if tooltipGui and tooltipGui.Parent then
		return
	end
	tooltipGui = Create("ScreenGui", {
		Name = "CelestialTooltip", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 20000,
	})
	ProtectGui(tooltipGui)
	tooltipLabel = Create("TextLabel", {
		BackgroundColor3 = Color3.fromRGB(15, 15, 20), TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.Gotham, TextSize = 12, AutomaticSize = Enum.AutomaticSize.XY,
		Visible = false, ZIndex = 500, Text = "", TextWrapped = true, BorderSizePixel = 0,
		Size = UDim2.fromOffset(0, 0),
	}, tooltipGui)
	Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
		PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5),
	}, tooltipLabel)
	Corner(tooltipLabel, 5)
	Stroke(tooltipLabel, Color3.fromRGB(80, 80, 100), 1)

	Connect(UserInputService.InputChanged, function(input)
		if tooltipLabel.Visible and input.UserInputType == Enum.UserInputType.MouseMovement then
			tooltipLabel.Position = UDim2.fromOffset(input.Position.X + 16, input.Position.Y + 16)
		end
	end)
end

function Library:ShowTooltip(text)
	if not text or text == "" then
		return
	end
	self:_initTooltip()
	tooltipLabel.Text = text
	tooltipLabel.Visible = true
	local ok, mouse = pcall(function() return UserInputService:GetMouseLocation() end)
	if ok then
		tooltipLabel.Position = UDim2.fromOffset(mouse.X + 16, mouse.Y + 16)
	end
end

function Library:HideTooltip()
	if tooltipLabel then
		tooltipLabel.Visible = false
	end
end

local function BindTooltip(row, text)
	if not text or text == "" then
		return
	end
	row.MouseEnter:Connect(function() Library:ShowTooltip(text) end)
	row.MouseLeave:Connect(function() Library:HideTooltip() end)
end

