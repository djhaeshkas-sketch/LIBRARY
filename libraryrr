		----------------------------------------------------------------
		-- Feature card
		----------------------------------------------------------------
		function Tab:AddFeature(fcfg)
			fcfg = fcfg or {}
			local F = {
				Name = fcfg.Name or "Feature", Desc = fcfg.Desc or "", Enabled = false,
				Flag = fcfg.Flag or (name .. "." .. (fcfg.Name or "Feature")),
				Callback = fcfg.Callback, Bind = fcfg.Bind, Elements = {}, Options = {}, Tab = Tab, Window = Window,
			}

			local card = Create("Frame", {
				Name = F.Name, BackgroundColor3 = T.Card, BorderSizePixel = 0, LayoutOrder = #Tab.Features + 1,
			}, scroll)
			Corner(card, 8)
			local stroke = Stroke(card, T.Border, 1)
			F.Card = card

			local title = Label(card, {
				Name = "Title", Size = UDim2.new(1, -80, 0, 18), Position = UDim2.fromOffset(12, 10),
				Text = F.Name, Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 2,
			})
			local desc = Label(card, {
				Name = "Desc", Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 32),
				Text = F.Desc, TextSize = 11, TextColor3 = T.SubText, TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 2,
			})

			local clickArea = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 1 }, card)

			local icons = Create("Frame", {
				Size = UDim2.fromOffset(56, 20), Position = UDim2.new(1, -62, 0, 8), BackgroundTransparency = 1, ZIndex = 3,
			}, card)
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
			}, icons)
			local setBtn = IconButton(icons, Library.Icons.CardSettings, "⚙", 18)
			setBtn.LayoutOrder, setBtn.ZIndex, setBtn.Visible = 1, 3, false
			local bindBtn, bindProp = IconButton(icons, Library.Icons.CardBind, "⌨", 18)
			bindBtn.LayoutOrder, bindBtn.ZIndex = 2, 3

			-- визуальное состояние
			local gradTween
			local function startGradient()
				local g = card:FindFirstChild("ActiveGradient") or Create("UIGradient", {
					Name = "ActiveGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromHex("#2a0a3d")),
						ColorSequenceKeypoint.new(0.5, Color3.fromHex("#4a1670")),
						ColorSequenceKeypoint.new(1, Color3.fromHex("#2a0a3d")),
					}),
				}, card)
				if gradTween then gradTween:Cancel() end
				gradTween = Loop(g, 4, { Rotation = 360 })
			end
			local function stopGradient()
				if gradTween then gradTween:Cancel() gradTween = nil end
				local g = card:FindFirstChild("ActiveGradient")
				if g then g:Destroy() end
			end

			local function applyVisual(on, animate)
				if on then
					if animate then
						local pulse = Create("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
							BackgroundColor3 = T.Accent, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 0,
						}, card)
						Corner(pulse, 8)
						Tween(pulse, 0.6, { Size = UDim2.fromScale(1.3, 1.3), BackgroundTransparency = 1 })
						task.delay(0.6, function() pulse:Destroy() end)
					end
					card.BackgroundColor3 = Color3.new(1, 1, 1) -- белая база, цвет даёт градиент
					startGradient()
					stroke.Color = T.ActiveBorder
					title.TextColor3 = T.AccentText
				else
					stopGradient()
					card.BackgroundColor3 = T.Card
					stroke.Color = T.Border
					title.TextColor3 = T.Text
				end
			end

			clickArea.MouseEnter:Connect(function()
				if F.Enabled then return end
				Tween(card, 0.2, { BackgroundColor3 = T.CardHover })
				Tween(stroke, 0.2, { Color = T.ActiveBorder })
				Tween(title, 0.2, { TextColor3 = T.AccentText })
			end)
			clickArea.MouseLeave:Connect(function()
				if F.Enabled then return end
				Tween(card, 0.2, { BackgroundColor3 = T.Card })
				Tween(stroke, 0.2, { Color = T.Border })
				Tween(title, 0.2, { TextColor3 = T.Text })
			end)
			clickArea.MouseButton1Click:Connect(function() F:Toggle() end)
			setBtn.MouseButton1Click:Connect(function() Window:OpenPopup(F) end)
			bindBtn.MouseButton1Click:Connect(function()
				Library:Notify({ Title = "Нажми клавишу для " .. F.Name, Text = "Esc / Backspace — сбросить бинд" })
				Library:_listenKey(function(key)
					F:SetBind(key)
					Library:Notify({ Title = F.Name .. ": " .. (key and key.Name or "бинд сброшен") })
				end)
			end)

			-- публичный API фичи
			function F:Set(state, silent)
				state = not not state
				if self.Enabled == state then return end
				self.Enabled = state
				Library.Flags[self.Flag] = state
				applyVisual(state, not silent)
				if not silent and Window.NotifyOnToggle and fcfg.Notify ~= false then
					Library:Notify({
						Title = self.Name .. (state and " включён" or " выключен"),
						Text = state and "Функция активирована" or "Информация",
						Type = state and "success" or "info",
					})
				end
				Fire(self.Callback, state)
			end
			function F:Toggle() self:Set(not self.Enabled) end
			function F:SetBind(key)
				self.Bind = key
				Library.Flags[self.Flag .. "$bind"] = key or false
				Tween(bindBtn, 0.15, { [bindProp] = key and T.ActiveBorder or T.SubText })
			end

			local function addElement(self, kind, ename, opts)
				opts = opts or {}
				local el = { Type = kind, Name = opts.Name or ename, Flag = self.Flag .. "." .. ename, Opts = opts, Feature = self }
				if kind == "Toggle" then el.Value = opts.Default or false
				elseif kind == "Slider" then el.Value = opts.Default or opts.Min or 0
				elseif kind == "Dropdown" then el.Value = opts.Default or (opts.Values and opts.Values[1])
				elseif kind == "Color" then el.Value = opts.Default or Color3.new(1, 1, 1)
				elseif kind == "Keybind" then el.Value = opts.Default end

				if kind == "Keybind" then
					el.OnPress, el.Callback = opts.Callback, opts.OnChanged -- Callback = нажатие, OnChanged = смена бинда
				else
					el.Callback = opts.Callback
				end

				function el:Get() return self.Value end
				function el:Set(v, silent)
					self.Value = v
					Library.Flags[self.Flag] = (v == nil) and false or v
					if self._refresh then self._refresh() end
					if not silent then Fire(self.Callback, v) end
				end

				Library.Flags[el.Flag] = (el.Value == nil) and false or el.Value
				Library.Elements[el.Flag] = el
				self.Options[ename] = el
				table.insert(self.Elements, el)
				setBtn.Visible = true
				return el
			end
			function F:AddToggle(n, o) return addElement(self, "Toggle", n, o) end
			function F:AddSlider(n, o) return addElement(self, "Slider", n, o) end
			function F:AddDropdown(n, o) return addElement(self, "Dropdown", n, o) end
			function F:AddColorPicker(n, o) return addElement(self, "Color", n, o) end
			function F:AddKeybind(n, o) return addElement(self, "Keybind", n, o) end

			Library.Flags[F.Flag] = false
			table.insert(Tab.Features, F)
			table.insert(Library.Features, F)
			Library.FeatureByFlag[F.Flag] = F
			if F.Bind then F:SetBind(F.Bind) end

			-- каскадное появление
			card.BackgroundTransparency, title.TextTransparency, desc.TextTransparency = 1, 1, 1
			task.delay(0.05 * #Tab.Features, function()
				if not card.Parent then return end
				Tween(card, 0.3, { BackgroundTransparency = 0 })
				Tween(title, 0.3, { TextTransparency = 0 })
				Tween(desc, 0.3, { TextTransparency = 0 })
			end)

			if fcfg.Default then F:Set(true, true) end
			return F
		end

		Window.Tabs[name] = Tab
		table.insert(Window.TabList, Tab)
		if not Window.Current then
			task.defer(function() Window:SelectTab(Tab) end)
		end
		return Tab
	end

	function Window:Notify(opts) Library:Notify(opts) end

	function Window:Destroy()
		Window:ClosePopup()
		Window:CloseConfigPopup()
		gui:Destroy()
		local idx = table.find(Library.Windows, Window)
		if idx then
			table.remove(Library.Windows, idx)
		end
	end

	table.insert(self.Windows, Window)
	return Window
end

----------------------------------------------------------------------
-- Глобальный обработчик клавиш: ToggleKey окна, бинды фич, Keybind-элементы
----------------------------------------------------------------------
function Library:_init()
	if self._inited then
		return
	end
	self._inited = true
	Connect(UserInputService.InputBegan, function(input, gpe)
		if gpe or self._listening or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		for _, w in ipairs(self.Windows) do
			if w.ToggleKey == key then w:Toggle() end
		end
		for _, f in ipairs(self.Features) do
			if f.Bind == key then f:Toggle() end
		end
		for _, el in pairs(self.Elements) do
			if el.Type == "Keybind" and el.Value == key then Fire(el.OnPress) end
		end
	end)
end

----------------------------------------------------------------------
-- Конфиги (нужны writefile/readfile/isfolder/makefolder/delfile — есть в большинстве executor'ов)
----------------------------------------------------------------------
function Library:SaveConfig(name)
	if not (writefile and makefolder and isfolder) then
		return false, "файловые функции недоступны"
	end
	if not isfolder(self.ConfigFolder) then
		makefolder(self.ConfigFolder)
	end
	local data = {}
	for flag, v in pairs(self.Flags) do
		data[flag] = Encode(v)
	end
	writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	return true
end

function Library:LoadConfig(name)
	if not (readfile and isfile) then
		return false, "файловые функции недоступны"
	end
	local path = self.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then
		return false, "конфиг не найден"
	end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok then
		return false, "битый json"
	end
	for flag, raw in pairs(data) do
		local v = Decode(raw)
		local feature = self.FeatureByFlag[flag]
		if feature then
			feature:Set(v == true, true)
		elseif flag:sub(-5) == "$bind" then
			local f2 = self.FeatureByFlag[flag:sub(1, -6)]
			if f2 then f2:SetBind(v or nil) end
		else
			local el = self.Elements[flag]
			if el then
				if el.Type == "Keybind" and v == false then v = nil end
				el:Set(v)
			end
		end
	end
	return true
end

function Library:ListConfigs()
	local out = {}
	if listfiles and isfolder and isfolder(self.ConfigFolder) then
		for _, path in ipairs(listfiles(self.ConfigFolder)) do
			local n = path:match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end
	return out
end

----------------------------------------------------------------------
-- Unload: выключает все фичи (вызывает их Callback(false)), рвёт соединения, удаляет GUI
----------------------------------------------------------------------
function Library:Unload()
	for _, f in ipairs(self.Features) do
		if f.Enabled then f:Set(false, true) end
	end
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	table.clear(self.Connections)
	for _, w in ipairs(table.clone(self.Windows)) do
		w:Destroy()
	end
	if notifyGui then notifyGui:Destroy() notifyGui = nil end
	self._inited = false
end

return Library
