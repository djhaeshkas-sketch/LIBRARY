	-- Анимация показа/скрытия окна (скейл + фейд, туда — Back Out, обратно — Back In)
	local visTween
	function Window:SetVisible(state)
		if state == Window.Visible then
			return
		end
		Window.Visible = state
		if visTween then
			visTween:Cancel()
			visTween = nil
		end
		Window:ClosePopup()
		Window:CloseConfigPopup()
		Window:CloseFriendPopup()
        Window:CloseThemePopup()

		local targetH = Window.Minimized and 45 or size.Y

		if state then
			main.Visible = true
			main.Size = UDim2.new()
			main.BackgroundTransparency = 1
			visTween = Tween(main, 0.35, { Size = UDim2.fromOffset(size.X, targetH), BackgroundTransparency = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		else
			visTween = Tween(main, 0.25, { Size = UDim2.new(), BackgroundTransparency = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			visTween.Completed:Connect(function()
				if not Window.Visible then
					main.Visible = false
				end
			end)
		end
	end
	function Window:Toggle() Window:SetVisible(not Window.Visible) end

	-- Перетаскивание окна с ограничением в пределах экрана, чтобы окно нельзя было утащить за край
	local dragging, dragStart, startPos = false, nil, nil
	local function makeHandle(handle)
		handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				-- переводим текущую позицию в чистый Offset от левого верхнего угла,
				-- чтобы клампить было просто (независимо от AnchorPoint/Scale)
				startPos = UDim2.fromOffset(main.AbsolutePosition.X, main.AbsolutePosition.Y)
			end
		end)
		handle.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end
	makeHandle(topbar)
	makeHandle(logoFrame)
	Connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			local w, h = main.AbsoluteSize.X, main.AbsoluteSize.Y
			local screen = gui.AbsoluteSize -- размер экрана, который покрывает ScreenGui

			-- целевой левый верхний угол окна
			local newX = startPos.X.Offset + d.X
			local newY = startPos.Y.Offset + d.Y

			-- клампим так, чтобы окно целиком оставалось в пределах видимой области
			newX = math.clamp(newX, 0, math.max(screen.X - w, 0))
			newY = math.clamp(newY, 0, math.max(screen.Y - h, 0))

			-- у main AnchorPoint = (0.5, 0.5), поэтому переводим левый-верхний угол обратно в координаты центра
			main.Position = UDim2.fromOffset(newX + w / 2, newY + h / 2)
		end
	end)

