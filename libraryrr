		Tabs = {}, TabList = {}, Current = nil, Minimized = false, Visible = true,
		ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightControl,
		NotifyOnToggle = cfg.NotifyOnToggle ~= false,
	}
	local order = 0
	local function nextOrder() order += 1 return order end
	local size = cfg.Size or Vector2.new(800, 520)

	local gui = Create("ScreenGui", {
		Name = cfg.Name or "CelestialUI", ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999,
	})
	ProtectGui(gui)
	Window.Gui = gui

	-- Главное окно: AnchorPoint по центру, поэтому анимация открытия = просто твин размера
