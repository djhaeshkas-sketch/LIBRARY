	function Window:SelectTab(tab)
		if type(tab) == "string" then
			tab = Window.Tabs[tab]
		end
		if not tab or Window.Current == tab then
			return
		end
		Window:ClosePopup()
		Window:CloseConfigPopup()
		Window:CloseFriendPopup()
        Window:CloseThemePopup()
		if Window.Current then
			Window.Current._setSelected(false)
			Window.Current.Scroll.Visible = false
		end
		Window.Current = tab
		tab._setSelected(true)
		tab.Scroll.Position = UDim2.fromOffset(15, 28)
		tab.Scroll.Visible = true
		Tween(tab.Scroll, 0.25, { Position = UDim2.fromOffset(15, 10) })
		Window:_applySearch()
	end

	-- Поиск ищет по всем вкладкам; если совпадений на текущей нет, а на другой есть — переключается сама.
	function Window:_applySearch()
		local q = searchBox.Text:lower()
		if q == "" then
			if Window.Current then
				for _, f in ipairs(Window.Current.Features) do
					f.Card.Visible = true
				end
			end
			return
		end

		local matchTab, anyMatchOnCurrent = nil, false
		for _, tab in ipairs(Window.TabList) do
			local hasMatch = false
			for _, f in ipairs(tab.Features) do
				local m = f.Name:lower():find(q, 1, true) ~= nil
				if tab == Window.Current then
					f.Card.Visible = m
				end
				if m then hasMatch = true end
			end
			if tab == Window.Current then anyMatchOnCurrent = hasMatch end
			if hasMatch and not matchTab then matchTab = tab end
		end

		if not anyMatchOnCurrent and matchTab and matchTab ~= Window.Current then
			Window:SelectTab(matchTab) -- SelectTab сам вызовет _applySearch ещё раз для новой вкладки
		end
	end
	searchBox:GetPropertyChangedSignal("Text"):Connect(function() Window:_applySearch() end)

