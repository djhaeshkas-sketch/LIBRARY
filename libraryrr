	})

	local sidebarContent = Create("Frame", {
		Size = UDim2.new(1, 0, 1, -55), Position = UDim2.fromOffset(0, 50), BackgroundTransparency = 1,
	}, sidebar)
	Create("UIListLayout", {
		Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	}, sidebarContent)
	Create("UIPadding", { PaddingTop = UDim.new(0, 4) }, sidebarContent)

	-- Topbar
	local topbar = Create("Frame", {
		Name = "Topbar", Size = UDim2.new(1, -160, 0, 45), Position = UDim2.fromOffset(160, 0),
		BackgroundColor3 = T.Topbar, BorderSizePixel = 0,
	}, main)
	Window.Topbar = topbar

	local searchFrame = Create("Frame", {
		Size = UDim2.fromOffset(240, 28), Position = UDim2.new(0, 15, 0.5, -14),
		BackgroundColor3 = Color3.fromRGB(20, 20, 28), BorderSizePixel = 0,
	}, topbar)
	Corner(searchFrame, 6)
	local textX = 10
	if self.Icons.Search ~= "" then
		Create("ImageLabel", {
			Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 10, 0.5, -8), BackgroundTransparency = 1,
			Image = self.Icons.Search, ImageColor3 = T.SubText, ScaleType = Enum.ScaleType.Fit,
		}, searchFrame)
		textX = 34
	end
	local searchBox = Create("TextBox", {
		Name = "Search", Size = UDim2.new(1, -(textX + 4), 1, 0), Position = UDim2.fromOffset(textX, 0),
		BackgroundTransparency = 1, Text = "", PlaceholderText = cfg.SearchPlaceholder or "Поиск",
		TextColor3 = T.Text, PlaceholderColor3 = T.SubText, Font = Enum.Font.Gotham, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
	}, searchFrame)

	local topRight = Create("Frame", {
		Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(1, -215, 0, 0), BackgroundTransparency = 1,
	}, topbar)
	Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder,
	}, topRight)

	local contentFrame = Create("Frame", {
		Name = "Content", Size = UDim2.new(1, -160, 1, -45), Position = UDim2.fromOffset(160, 45),
		BackgroundTransparency = 1, ClipsDescendants = true,
	}, main)

	------------------------------------------------------------------
	-- Блокировщик клика по фону, пока открыт попап
	-- (чтобы карточки фич за попапом не тыкались и не переключались случайно)
	------------------------------------------------------------------
	function Window:_addBlocker(zindex)
		self:_removeBlocker()
		local b = Create("TextButton", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
			AutoButtonColor = false, ZIndex = zindex or 90, Active = true,
		}, overlay)
		b.MouseButton1Click:Connect(function()
			self:ClosePopup()
			self:CloseConfigPopup()
			self:CloseFriendPopup()
            self:CloseThemePopup()
		end)
		self._blocker = b
	end
	function Window:_removeBlocker()
		if self._blocker then
			self._blocker:Destroy()
			self._blocker = nil
		end
	end

	-- Позиция по центру текущего положения окна (main может быть уже подвинут пользователем),
	-- в системе координат overlay (обычно та же, что у main, т.к. overlay = полный экран без смещения).
	local function centerOverMain()
		return UDim2.fromOffset(
			main.AbsolutePosition.X + main.AbsoluteSize.X / 2 - overlay.AbsolutePosition.X,
			main.AbsolutePosition.Y + main.AbsoluteSize.Y / 2 - overlay.AbsolutePosition.Y
		)
	end
	local function overlayBounds()
		return overlay.AbsoluteSize
	end

	------------------------------------------------------------------
	-- Popup настроек фичи
	------------------------------------------------------------------
	local popup, popupFeature, popupConns = nil, nil, {}

	function Window:ClosePopup()
		if not popup then
			self:_removeBlocker()
			return
		end
		local p = popup
		popup = nil
		for _, c in ipairs(popupConns) do
			c:Disconnect()
		end
		popupConns = {}
		if popupFeature then
			ClearRefreshRecursive(popupFeature.Elements)
		end
