			ColorSequenceKeypoint.new(1, Color3.fromHex("#9d4edd")),
		}),
	}, logoBg) -- лого намеренно остаётся фирменным цветом независимо от темы
	local logoId = cfg.Logo or self.Icons.Logo
	if logoId and logoId ~= "" then
		Create("ImageLabel", {
			Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1,
			Image = logoId, ScaleType = Enum.ScaleType.Fit,
		}, logoBg)
	end
	Label(logoFrame, {
		Size = UDim2.new(1, -56, 0, 32), Position = UDim2.fromOffset(52, 9), Text = cfg.Title or "Celestial",
