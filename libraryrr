Renderers.Slider = function(el, parent, conns)
	local T = Library.Theme
	local o = el.Opts
	local min, max, step = o.Min or 0, o.Max or 100, o.Increment or 1
	local row = Row(parent, ROW_HEIGHT.Slider)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -80, 0, 22) })
	BindTooltip(row, o.Tooltip)
	local valueLbl = Label(row, {
		Size = UDim2.fromOffset(70, 22), Position = UDim2.new(1, -80, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.SubText,
	})
	local track = Create("Frame", {
		Size = UDim2.new(1, -20, 0, 4), Position = UDim2.new(0, 10, 1, -13),
		BackgroundColor3 = Color3.fromRGB(50, 50, 62), BorderSizePixel = 0,
	}, row)
	Corner(track, 2)
	local fill = Create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.ActiveBorder, BorderSizePixel = 0 }, track)
	Corner(fill, 2)
	local hit = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -24), BackgroundTransparency = 1, Text = "",
	}, row)

	local function refresh()
		local a = (max == min) and 0 or (el.Value - min) / (max - min)
		fill.Size = UDim2.fromScale(math.clamp(a, 0, 1), 1)
		fill.BackgroundColor3 = Library.Theme.ActiveBorder
		valueLbl.Text = tostring(el.Value) .. (o.Suffix or "")
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min)
		v = math.clamp(v, min, max)
		-- округление к ближайшему шагу; math.floor(v/step + 0.5) корректно и для отрицательных v,
		-- т.к. считаем от абсолютного значения шага, а не от знака v
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(v, min, max)
		v = tonumber(string.format("%.4f", v)) -- убираем погрешность float
		if v ~= el.Value then
			el:Set(v)
		end
	end

	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	el._refresh = refresh
	refresh()
end

-- Настоящий выпадающий список: клик открывает панель поверх всего окна (не только popup),
-- скролл если значений > 6, закрытие по клику вне списка/кнопки.
Renderers.Dropdown = function(el, parent, conns, hostFrame)
	local o = el.Opts
	local values = o.Values or {}
	local row = Row(parent, ROW_HEIGHT.Dropdown)
	RowLabel(row, el.Name, { Size = UDim2.new(1, -130, 1, 0) })
	BindTooltip(row, o.Tooltip)
	local btn = SmallButton(row, 110)
	btn.Text = tostring(el.Value)

	local list, outsideConn

	local function closeList()
		if list then
			list:Destroy()
			list = nil
		end
		if outsideConn then
			outsideConn:Disconnect()
			outsideConn = nil
		end
	end

	local function openList()
		closeList()
		if not hostFrame then
			return
		end
		local T = Library.Theme
		local itemH = 26
		local visibleCount = math.max(1, math.min(#values, 6))
		local listH = visibleCount * itemH + 4

		local abs = btn.AbsolutePosition
		local relX = abs.X - hostFrame.AbsolutePosition.X
		local relY = abs.Y - hostFrame.AbsolutePosition.Y + btn.AbsoluteSize.Y + 2

		-- клэмпим в пределах hostFrame, чтобы список не "улетал" и не резался за край
		local bounds = hostFrame.AbsoluteSize
		relX = math.clamp(relX, 0, math.max(bounds.X - 110, 0))
		relY = math.clamp(relY, 0, math.max(bounds.Y - listH, 0))

		list = Create("Frame", {
			Size = UDim2.fromOffset(110, listH), Position = UDim2.fromOffset(relX, relY),
			BackgroundColor3 = T.Popup, BorderSizePixel = 0, ZIndex = 250, ClipsDescendants = true, Active = true,
		}, hostFrame)
		Corner(list, 6)
		Stroke(list, T.ActiveBorder, 1)

		local scroll = Create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 3, ScrollBarImageColor3 = T.Border, CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 251,
		}, list)
		Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

		for i, v in ipairs(values) do
			local isSel = (v == el.Value)
			local opt = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, itemH), BackgroundColor3 = T.ActiveBorder,
				BackgroundTransparency = isSel and 0.6 or 1, Text = tostring(v), TextColor3 = T.Text,
				Font = Enum.Font.Gotham, TextSize = 12, AutoButtonColor = false, LayoutOrder = i, ZIndex = 251,
			}, scroll)
			opt.MouseEnter:Connect(function() Tween(opt, 0.1, { BackgroundTransparency = 0.3 }) end)
			opt.MouseLeave:Connect(function() Tween(opt, 0.1, { BackgroundTransparency = isSel and 0.6 or 1 }) end)
			opt.MouseButton1Click:Connect(function()
				el:Set(v)
				closeList()
			end)
		end

		task.defer(function()
			outsideConn = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local pos = input.Position
					local inList, inBtn = false, false
					if list then
						local la, lb = list.AbsolutePosition, list.AbsoluteSize
						inList = pos.X >= la.X and pos.X <= la.X + lb.X and pos.Y >= la.Y and pos.Y <= la.Y + lb.Y
					end
					local ba, bb = btn.AbsolutePosition, btn.AbsoluteSize
					inBtn = pos.X >= ba.X and pos.X <= ba.X + bb.X and pos.Y >= ba.Y and pos.Y <= ba.Y + bb.Y
					if not inList and not inBtn then
						closeList()
					end
				end
			end)
		end)
	end

	btn.MouseButton1Click:Connect(function()
		if list then closeList() else openList() end
	end)

	local function refresh()
		btn.Text = tostring(el.Value)
	end
	el._refresh = refresh
	el._closeDropdown = closeList
	refresh()
end

